# Opcional para correr uvicorn fuera de Compose (backend/.env).
# En Docker, estas variables las inyecta docker-compose.yml.

DATABASE_URL=postgresql+psycopg://pulso:TU_PASSWORD@localhost:5433/pulsovecinal
JWT_SECRET=dev-secret-change-me
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Limite de frecuencia por IP (valores por defecto mostrados).
# TRUSTED_PROXY_HOPS: 1 detras de un ALB; 2 si ademas hay nginx delante de la API.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SURVEYS_PER_MINUTE=5
RATE_LIMIT_SURVEYS_PER_HOUR=30
RATE_LIMIT_LOGIN_PER_MINUTE=10
TRUSTED_PROXY_HOPS=1
