# Plantilla de entorno para la API PulsoVecinal (capa de negocio).
# Copia estos valores al .env de la RAÍZ (junto a POSTGRES_*) o usa
# `docker run --env-file` al levantar solo esta imagen.
# NUNCA versiones un .env con secretos reales.

POSTGRES_USER=pulso
POSTGRES_PASSWORD=
POSTGRES_DB=pulsovecinal
# Hostname del servicio de BD en la red de Compose. Desde el host usa localhost.
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Opcional: DSN completo (gana sobre POSTGRES_*). Mismo contrato que db/README.md
# DATABASE_URL=postgresql+psycopg://pulso:TU_PASSWORD@db:5432/pulsovecinal

JWT_SECRET=cambia-esta-clave-en-produccion
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
API_PORT=8000
