# Plantilla de entorno para la base de datos PulsoVecinal
# 1. Copia este archivo a la RAÍZ del repositorio (donde está docker-compose.yml):
#      Windows (PowerShell):  Copy-Item db\.env.example .env
#      Git Bash / Linux:      cp db/.env.example .env
# 2. Asigna una contraseña local en POSTGRES_PASSWORD (el valor que prefieras).
# 3. NUNCA versiones el archivo .env (ya está en .gitignore); solo esta plantilla se commitea.

POSTGRES_USER=pulso
POSTGRES_PASSWORD=
POSTGRES_DB=pulsovecinal
DB_PORT=5433
